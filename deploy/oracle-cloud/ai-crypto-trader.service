[Unit]
Description=AI Crypto Trader V2 dashboard (paper trading only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/ai-crypto-trader
EnvironmentFile=/etc/ai-crypto-trader.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-crypto-trader/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ai-crypto-trader

[Install]
WantedBy=multi-user.target
