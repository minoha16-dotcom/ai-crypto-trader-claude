APP_NAME=AI Crypto Trader V2
DATABASE_URL=sqlite:///./data/trader.db
# For Render + Supabase, replace with the full PostgreSQL Session Pooler URI (keep it secret).
DEFAULT_EXCHANGE=kucoin

# Required for protected dashboard/API routes; startup fails if either value is blank.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Old signals are soft archived (never deleted) after this many days.
SIGNAL_RETENTION_DAYS=365
DEFAULT_MARKET_TYPE=spot
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_RISK_PCT=2.0
MAX_DAILY_LOSS_PCT=3.0
MAX_POSITION_NOTIONAL_PCT=20.0
MAX_OPEN_TRADES=3
REWARD_RISK_RATIO=2.0
PAPER_STARTING_BALANCE=10000
POSITION_MONITOR_MAX_PRICE_AGE_SECONDS=120
MAX_FUTURES_LEVERAGE=5
MAX_FUTURES_MARGIN_PCT=50
PAPER_FUTURES_DEFAULT_FUNDING_RATE=0.0001
PAPER_FUTURES_FUNDING_INTERVAL_HOURS=8
PAPER_FUTURES_MAINTENANCE_MARGIN_RATE=0.005
PAPER_FUTURES_LIQUIDATION_FEE_RATE=0.005
SCAN_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
SCAN_TIMEFRAME=1h
